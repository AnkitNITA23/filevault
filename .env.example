# App Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# PostgreSQL Configuration
# Example: postgresql://username:password@hostname:port/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/filevault_db

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Fallback Settings (Optional)
# If set to true, forces the app to use local disk storage and SQLite, even if S3/Postgres variables are defined
FORCE_LOCAL_FALLBACK=false
